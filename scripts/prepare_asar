from pathlib import Path

patched = False
needle = "function m(e){let t=`[${e}] `,n=(e,n,r)=>{l().log(e,`${t}${n}`,i(r))},r=e=>(t,r)=>{n(e,t,r)};return{trace:r(`trace`),debug:r(`debug`),info:r(`info`),warning:r(`warning`),error:r(`error`),log:(e,t,r)=>{n(e,t,r)},dispose:()=>{l().dispose()}}}"
replacement = "var y=new Set([`git`,`electron-message-handler`,`electron-fetch-wrapper`,`AppServerConnection`]);function m(e){if(y.has(e))return{trace(){},debug(){},info(){},warning(){},error(){},log(){},dispose(){}};let t=`[${e}] `,n=(e,n,r)=>{l().log(e,`${t}${n}`,i(r))},r=e=>(t,r)=>{n(e,t,r)};return{trace:r(`trace`),debug:r(`debug`),info:r(`info`),warning:r(`warning`),error:r(`error`),log:(e,t,r)=>{n(e,t,r)},dispose:()=>{l().dispose()}}}"
for path in Path("scratch/asar/.vite/build").glob("crash-reporter-env-*.js"):
    source = path.read_text(errors="ignore")
    if needle not in source:
        continue
    path.write_text(source.replace(needle, replacement, 1))
    patched = True
    break

if not patched:
    raise SystemExit("Failed to patch noisy logger names")
