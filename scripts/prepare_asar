python3 - <<'PY'
import re
from pathlib import Path

pattern = re.compile(r"(?P<prefix>var\s+|,)(?P<name>[A-Za-z0-9_$]+)=(?P<factory>[A-Za-z0-9_$.]+)\(`git`\)")
replacement = lambda m: (
    f"{m.group('prefix')}{m.group('name')}=()=>({{trace(){{}},debug(){{}},info(){{}},warning(){{}},error(){{}},log(){{}},dispose(){{}}}})"
)
patched = 0
for path in Path("scratch/asar/.vite/build").glob("*.js"):
    source = path.read_text(errors="ignore")
    source, count = pattern.subn(replacement, source)
    if count:
        path.write_text(source)
        patched += count

if not patched:
    raise SystemExit("Failed to patch inlined git loggers")
PY

python3 - <<'PY'
from pathlib import Path

path = Path("scratch/asar/.vite/build/worker.js")
source = path.read_text(errors="ignore")
patches = [
    (
        "worker review summary untracked files",
        "async function Voe({host:e,gitRoot:t,metadata:n,reviewSnapshot:r,source:i,untrackedPathSet:a}){let o=Y8(n.files.map(e=>e.previousPath==null&&a.has(e.path)?{...e,changeKind:`untracked`}:e)),s=await B8(r,n.rawEntries.filter(e=>e.status!==`D`&&/^0+$/.test(e.newOid)).map(e=>e.path));return s==null?null:(await Woe({host:e,files:o,gitRoot:t,rawEntries:n.rawEntries.map(e=>({...e,newOid:s.get(e.path)?.oid??e.newOid})),source:i,stats:n.stats})).sort((e,t)=>e.path.localeCompare(t.path))}",
        "async function Voe({host:e,gitRoot:t,metadata:n,reviewSnapshot:r,source:i,untrackedPathSet:a}){let o=new Set(n.files.map(e=>e.path)),s=[...a].filter(e=>!o.has(e)).map(e=>({additions:null,changeKind:`untracked`,deletions:null,path:e,previousPath:null})),c=Y8([...n.files.map(e=>e.previousPath==null&&a.has(e.path)?{...e,changeKind:`untracked`}:e),...s]);return s=await B8(r,n.rawEntries.filter(e=>e.status!==`D`&&/^0+$/.test(e.newOid)).map(e=>e.path)),s==null?null:(await Woe({host:e,files:c,gitRoot:t,rawEntries:n.rawEntries.map(e=>({...e,newOid:s.get(e.path)?.oid??e.newOid})),source:i,stats:n.stats})).sort((e,t)=>e.path.localeCompare(t.path))}",
    ),
]

for label, old, new in patches:
    replaced = source.replace(old, new, 1)
    if replaced == source:
        raise SystemExit(f"Failed to patch {label}")
    source = replaced

path.write_text(source)
PY


