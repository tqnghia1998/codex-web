python3 - <<'PY'
import re
from pathlib import Path

# The base logger factory (minified name drifts: m/p/...) is uniquely
# identified by its `[${e}] ` prefix template. Wrap it so a set of noisy
# logger names get a no-op logger instead of spamming the console.
pattern = re.compile(r"function (?P<name>[A-Za-z0-9_$]+)\(e\)\{let t=`\[\$\{e\}\] `,")
noop = "{trace(){},debug(){},info(){},warning(){},error(){},log(){},dispose(){}}"
sentinel = (
    "var __noisyLoggers=new Set([`git`,`electron-message-handler`,"
    "`electron-fetch-wrapper`,`AppServerConnection`]);"
)
repl = lambda m: (
    f"{sentinel}function {m.group('name')}(e)"
    f"{{if(__noisyLoggers.has(e))return {noop};let t=`[${{e}}] `,"
)

patched = False
for path in Path("scratch/asar/.vite/build").glob("crash-reporter-env-*.js"):
    source = path.read_text(errors="ignore")
    source, count = pattern.subn(repl, source, count=1)
    if count:
        path.write_text(source)
        patched = True
        break

if not patched:
    raise SystemExit("Failed to patch noisy logger names")
PY

