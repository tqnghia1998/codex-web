from pathlib import Path

required = [
    "SAVE_TAB_CONTEXT_ASSET_CREATE",
    "SAVE_TAB_CONTEXT_ASSET_APPEND_CHUNK",
    "SAVE_TAB_CONTEXT_ASSET_FINISH",
    "SAVE_TAB_CONTEXT_ASSET_ABORT",
    "SAVE_TAB_CONTEXT_ASSET_REMOVE",
]
source = "\n".join(
    path.read_text(errors="ignore")
    for path in Path("scratch/asar/webview/assets").glob("*.js")
)
missing = [token for token in required if token not in source]
if missing:
    raise SystemExit(
        "Missing browser attachment protocol tokens: " + ", ".join(missing)
    )
