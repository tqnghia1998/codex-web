python3 - <<'PY'
import re
from pathlib import Path

patched = False
pattern = re.compile(
    r"async function ([A-Za-z0-9_$]+)\(\)\{([A-Za-z0-9_$]+)=([A-Za-z0-9_$]+)\(\),([A-Za-z0-9_$]+)=await \2\.services,"
)
for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    source, count = pattern.subn(
        lambda match: (
            f"async function {match.group(1)}(){{"
            f"if(window.__ELECTRON_SHIM__?.services!=null)"
            f"{{{match.group(2)}={{services:Promise.resolve(window.__ELECTRON_SHIM__.services)}},{match.group(4)}=window.__ELECTRON_SHIM__.services}}"
            f"else {match.group(2)}={match.group(3)}(),"
            f"{match.group(4)}=await {match.group(2)}.services,"
        ),
        source,
        count=1,
    )
    if count:
        path.write_text(source)
        patched = True
        break

if not patched:
    raise SystemExit("Failed to patch app-host services")
PY

