python3 - <<'PY'
import re
from pathlib import Path

initial_route_patched = False
for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    source, count = re.subn(
        r"(\.current\?\?=[A-Za-z0-9_$]+\(\{initialEntries:)n(,initialIndex:[A-Za-z0-9_$]+,v5Compat:!0\}\))",
        r"\1n??[window.__ELECTRON_SHIM__?.initialRoute??`/`]\2",
        source,
        count=1,
    )
    if count:
        source, navigation_count = re.subn(
            r"(l=[A-Za-z0-9_$]+\.useCallback\(e=>\{)(i===!1\?c\(e\):[A-Za-z0-9_$]+\.startTransition\(\(\)=>[A-Za-z0-9_$]+\(e\)\))",
            r"\1window.__ELECTRON_SHIM__?.onMemoryNavigationChanged?.(e);\2",
            source,
            count=1,
        )
        path.write_text(source)
        initial_route_patched = True

if not initial_route_patched:
    raise SystemExit("Failed to patch initial route shim")

sidebar_patched = False
for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    if "sidebar-width" not in source or "data-app-shell-sidebar-trigger" not in source:
        continue

    marker = source.index("sidebar-width")
    prefix, tail = source[:marker], source[marker:]
    # Upstream renames the atom, scope, and spring constructor on every build.
    # These are the first sidebar-open atom and matching sidebar-motion atom
    # after the semantic sidebar markers above.
    tail, open_count = re.subn(
        r"(?P<store>[A-Za-z0-9_$]+)=(?P<atom>[A-Za-z0-9_$]+)\((?P<scope>[A-Za-z0-9_$]+),!0\)",
        r"\g<store>=\g<atom>(\g<scope>,window.__ELECTRON_SHIM__?.initialSidebarState??!0)",
        tail,
        count=1,
    )
    tail, spring_count = re.subn(
        r"(?P<store>[A-Za-z0-9_$]+)=(?P<atom>[A-Za-z0-9_$]+)\((?P<scope>[A-Za-z0-9_$]+),\(\)=>new (?P<spring>[A-Za-z0-9_$]+)\(1\)\)",
        r"\g<store>=\g<atom>(\g<scope>,()=>new \g<spring>(window.__ELECTRON_SHIM__?.initialSidebarState?1:0))",
        tail,
        count=1,
    )
    if not (open_count and spring_count):
        continue

    path.write_text(prefix + tail)
    sidebar_patched = True
    break

if not sidebar_patched:
    raise SystemExit("Failed to patch sidebar initial state")
PY

# The upgraded bundle centralized local-project resolution for thread
# creation into a single shared function that does a strict lookup in the
# LOCAL_PROJECTS catalog and throws "Unknown local project" on a miss. Our
# browser-mode `?folder=` flow feeds a raw filesystem path as projectId
# without ever registering it as a catalog entry, so this now fails where
# packaged Electron always goes through the "add project" UI first. Treat an
# unrecognized absolute-path projectId as a raw workspace root instead of a
# catalog miss, mirroring what packaged desktop's project picker would do.
python3 - <<'PY'
import re
from pathlib import Path

pattern = re.compile(
    r"async function ([A-Za-z0-9_$]+)\(\{projectId:([A-Za-z0-9_$]+),prompt:([A-Za-z0-9_$]+)\}\)"
    r"\{let\{value:([A-Za-z0-9_$]+)\}=await ([A-Za-z0-9_$]+)\(`get-global-state`,\{params:\{key:([A-Za-z0-9_$.]+)\}\}\),"
    r"([A-Za-z0-9_$]+)=([A-Za-z0-9_$]+)\(\4\)\[\2\];if\(\7==null\)return null;"
)
patched = False
for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    source, count = pattern.subn(
        lambda match: (
            f"async function {match.group(1)}({{projectId:{match.group(2)},prompt:{match.group(3)}}}){{"
            f"let{{value:{match.group(4)}}}=await {match.group(5)}(`get-global-state`,{{params:{{key:{match.group(6)}}}}}),"
            f"{match.group(7)}={match.group(8)}({match.group(4)})[{match.group(2)}];"
            f"if({match.group(7)}==null){{if(!{match.group(2)}.startsWith(`/`))return null;{match.group(7)}={{rootPaths:[{match.group(2)}]}}}}"
        ),
        source,
        count=1,
    )
    if count:
        path.write_text(source)
        patched = True
        break

if not patched:
    raise SystemExit("Failed to patch local project resolution fallback")
PY

# electronShim.services (browser mode) is a stub and lacks several services
# real desktop gets over the app-host MessageChannel bridge, which doesn't
# work in a plain browser tab. "threadProjectAssignments" is one of them, so
# saving a thread's project assignment threw instead of persisting. The
# bundle already ships a self-contained fallback (zer) that
# does the same persistence via the plain get/set-global-state RPC our
# local-project fallback above already relies on — just wire it in when the
# service object is missing instead of throwing.
python3 - <<'PY'
import re
from pathlib import Path

fallback_pattern = re.compile(
    r"function (?P<name>[A-Za-z0-9_$]+)\([^)]*\)\{"
    r"(?:(?!function ).){0,4000}?[A-Za-z0-9_$]+\.THREAD_PROJECT_ASSIGNMENTS"
    r"(?:(?!function ).){0,4000}?[A-Za-z0-9_$]+\.PROJECTLESS_THREAD_IDS"
    r"(?:(?!function ).){0,4000}?Failed to save or restore thread project membership",
    re.DOTALL,
)
pattern = re.compile(
    r"saveThreadProjectAssignment:async (?P<arg>[A-Za-z0-9_$]+)=>\{"
    r"let (?P<svc>[A-Za-z0-9_$]+)=(?P<holder>[A-Za-z0-9_$]+)\.threadProjectAssignments;"
    r"if\((?P=svc)==null\)throw Error\(`Thread project assignment service is unavailable`\);"
    r"await (?P=svc)\.setAssignment\((?P=arg)\),"
    r"(?P<scope>[A-Za-z0-9_$]+)!=null&&await (?P<persist>[A-Za-z0-9_$]+)\((?P=scope),\{\[(?P=arg)\.threadId\]:(?P=arg)\.assignment\}\)\}"
)
matches = []
for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    found = pattern.findall(source)
    if found:
        matches.append((path, source, found))

match_count = sum(len(found) for _, _, found in matches)
if match_count != 1:
    raise SystemExit(
        f"Failed to patch thread project assignment fallback: expected 1 match, found {match_count}"
    )

path, source, found = matches[0]
arg, svc, holder, scope, persist = found[0]
fallback_matches = fallback_pattern.findall(source)
if len(fallback_matches) != 1:
    raise SystemExit(
        "Failed to find thread project assignment fallback: "
        f"expected 1 match, found {len(fallback_matches)}"
    )
fallback = fallback_matches[0]
replacement = (
    f"saveThreadProjectAssignment:async {arg}=>{{let {svc}={holder}.threadProjectAssignments;"
    f"await({svc}==null?{fallback}({scope},{arg}):{svc}.setAssignment({arg})),"
    f"{scope}!=null&&await {persist}({scope},{{[{arg}.threadId]:{arg}.assignment}})}}"
)
path.write_text(pattern.sub(replacement, source, count=1))
PY

python3 - <<'PY'
import re
from pathlib import Path

# Browser mode cannot register the macOS bare-modifier helper used by the
# appshot global hotkey (for example, DoubleCommand). Disable only that
# service; appshot capture remains available through renderer UI actions.
pattern = re.compile(
    r"(?P<prefix>[A-Za-z0-9_$]+)=new (?P<service>[A-Za-z0-9_$]+)"
    r"\((?P<state>[A-Za-z0-9_$]+),(?P<settings>[A-Za-z0-9_$]+),"
    r"(?P<window>[A-Za-z0-9_$]+),(?P<enabled>[^,]+),(?P<native>[A-Za-z0-9_$]+),"
)
candidates = []
for path in Path("scratch/asar/.vite/build").glob("main-*.js"):
    source = path.read_text(errors="ignore")
    if "Registering appshot hotkey" not in source:
        continue
    for match in pattern.finditer(source):
        nearby = source[match.end() : match.end() + 1800]
        if "appshotHotkeysService:" in nearby:
            candidates.append((path, source, match))

if len(candidates) != 1:
    raise SystemExit(
        "Failed to disable appshot global hotkey: "
        f"expected 1 candidate, found {len(candidates)}"
    )

path, source, match = candidates[0]
path.write_text(source[: match.start("enabled")] + "!1" + source[match.end("enabled") :])
PY

