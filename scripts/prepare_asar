import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
source = path.read_text()
source, count = re.subn(
    r"function ([A-Za-z0-9_$]+)\(([^)]*)\)\{if\([^)]*\.app\.isReady\(\)\)throw Error\(`Sentry SDK should be initialized before the Electron app 'ready' event is fired`\);let [^;]+;",
    lambda match: f"function {match.group(1)}({match.group(2)}){{return;",
    source,
    count=1,
)
if not count:
    source, count = re.subn(
        r"(return GB\(\{)(dsn:)", r"\1enabled:!1,\2", source, count=1
    )
if count:
    path.write_text(source)
