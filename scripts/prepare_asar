#!/usr/bin/env bash
set -euo pipefail

CODEX_APP_DIR="${CODEX_APP_DIR:-/Applications/ChatGPT.app}"
APP_RESOURCES_DIR="$CODEX_APP_DIR/Contents/Resources"
APP_ASAR="$APP_RESOURCES_DIR/app.asar"
if [[ ! -f "$APP_ASAR" ]]; then
  echo "Codex Desktop app.asar not found: $APP_ASAR" >&2
  echo "Set CODEX_APP_DIR to the installed .app path." >&2
  exit 1
fi

rm -rf scratch/asar
if [[ ! -f "node_modules/@electron/asar/bin/asar.mjs" ]]; then
  echo "asar is not installed; run npm install" >&2
  exit 1
fi
node "node_modules/@electron/asar/bin/asar.mjs" extract "$APP_ASAR" "scratch/asar"
cp assets/* scratch/asar/webview/
PWA_SOURCE_ICON="scratch/asar/webview/assets/app-D0g8sCle.png"
PWA_TARGET_ICON="scratch/asar/webview/assets/pwa-icon-512.png"
PWA_ICON_SIZE=512
PWA_TOTAL_PADDING_PERCENT=25
PWA_CONTENT_SIZE=$((PWA_ICON_SIZE * (100 - PWA_TOTAL_PADDING_PERCENT) / 100))
PWA_PADDING_TOTAL=$((PWA_ICON_SIZE - PWA_CONTENT_SIZE))
PWA_PADDING_BEFORE=$((PWA_PADDING_TOTAL / 2))
PWA_PADDING_AFTER=$((PWA_PADDING_TOTAL - PWA_PADDING_BEFORE))
sharp -i "$PWA_SOURCE_ICON" -o "$PWA_TARGET_ICON" -f png resize "$PWA_CONTENT_SIZE" "$PWA_CONTENT_SIZE" --fit inside -- flatten white -- extend "$PWA_PADDING_BEFORE" "$PWA_PADDING_AFTER" "$PWA_PADDING_BEFORE" "$PWA_PADDING_AFTER" --background white -- removeAlpha
if [[ -n "${DEV:-}" ]]; then
  prettier --ignore-path /dev/null --ignore-unknown --write "scratch/asar"
fi


python3 - <<'PY'
import re
from pathlib import Path

index = Path("scratch/asar/webview/index.html")
source = index.read_text()
source, _ = re.subn(
    r"\s*<meta\s+http-equiv=[\"']Content-Security-Policy[\"'][^>]*>",
    "",
    source,
    flags=re.IGNORECASE,
)

def inject_once(marker: str, snippet: str) -> None:
    global source
    if snippet in source:
        return
    if marker not in source:
        raise SystemExit(f"Missing marker in webview/index.html: {marker}")
    source = source.replace(marker, f"{marker}\n{snippet}", 1)

inject_once(
    "<title>Codex</title>",
    """    <link rel=\"icon\" type=\"image/svg+xml\" href=\"./favicon.svg\" />
    <link rel=\"manifest\" href=\"/manifest.json\" />
    <style>
      .main-surface {
        --spacing-token-safe-header-left: 0px;
      }
    </style>""",
)
inject_once("<!-- PROD_BASE_TAG_HERE -->", '    <base href="/" />')
inject_once(
    "<!-- PROD_CSP_TAG_HERE -->",
    '    <script type="module" src="./assets/preload.js?v=8"></script>',
)

required = [
    '<link rel="icon" type="image/svg+xml" href="./favicon.svg" />',
    '<link rel="manifest" href="/manifest.json" />',
    '--spacing-token-safe-header-left: 0px;',
    '<base href="/" />',
    'src="./assets/preload.js?v=8"',
]
if any(item not in source for item in required):
    raise SystemExit("Failed to patch webview/index.html")

index.write_text(source)
PY

python3 - <<'PY'
from pathlib import Path

patched = False
for path in Path("scratch/asar/webview/assets").glob("index-*.js"):
    source = path.read_text(errors="ignore")
    updated = source.replace(
        "await e((async()=>{t(),i(),await a()}))();",
        'await e((async()=>{window.electronBridge||await import("./preload.js?v=8"),t(),i(),await a()}))();',
        1,
    )
    if updated != source:
        path.write_text(updated)
        patched = True

if not patched:
    raise SystemExit("Failed to patch index-*.js preload bootstrap")
PY

python3 - <<'PY'
import re
from pathlib import Path

initial_route_patched = False
for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    source, count = re.subn(
        r"(\.current\?\?=[A-Za-z0-9_$]+\(\{initialEntries:)n(,initialIndex:[A-Za-z0-9_$]+,v5Compat:!0\}\))",
        r"\1n??[window.__ELECTRON_SHIM__?.initialRoute??`/`]\2",
        source,
        count=1,
    )
    if count:
        source, navigation_count = re.subn(
            r"(l=[A-Za-z0-9_$]+\.useCallback\(e=>\{)(i===!1\?c\(e\):[A-Za-z0-9_$]+\.startTransition\(\(\)=>[A-Za-z0-9_$]+\(e\)\))",
            r"\1window.__ELECTRON_SHIM__?.onMemoryNavigationChanged?.(e);\2",
            source,
            count=1,
        )
        path.write_text(source)
        initial_route_patched = True

if not initial_route_patched:
    raise SystemExit("Failed to patch initial route shim")

sidebar_patched = False
for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    updated = source.replace(
        "Xy=oi(br,!0)",
        "Xy=oi(br,window.__ELECTRON_SHIM__?.initialSidebarState??!0)",
        1,
    )
    updated = updated.replace(
        "eb=oi(br,()=>new qr(1))",
        "eb=oi(br,()=>new qr(window.__ELECTRON_SHIM__?.initialSidebarState?1:0))",
        1,
    )
    if updated != source:
        path.write_text(updated)
        sidebar_patched = True
        break

if not sidebar_patched:
    raise SystemExit("Failed to patch sidebar initial state")

for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    source, count = re.subn(
        r"ge=x\?null:O\?\?Te\(`~`\)",
        "ge=x?null:P?.hostId==null&&P?.projectId!=null?P.projectId:O??Te(`~`)",
        source,
        count=1,
    )
    if count:
        path.write_text(source)

PY

python3 - <<'PY'
import re
from pathlib import Path

patched = False
pattern = re.compile(
    r"async function ([A-Za-z0-9_$]+)\(\)\{([A-Za-z0-9_$]+)=([A-Za-z0-9_$]+)\(\),([A-Za-z0-9_$]+)=await \2\.services,\4\.devboxService\}",
)
for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    source, count = pattern.subn(
        lambda match: (
            f"async function {match.group(1)}(){{"
            f"if(window.__ELECTRON_SHIM__?.services!=null){{"
            f"{match.group(2)}={{services:Promise.resolve(window.__ELECTRON_SHIM__.services)}},"
            f"{match.group(4)}=window.__ELECTRON_SHIM__.services,"
            f"{match.group(4)}.devboxService;return}}"
            f"{match.group(2)}={match.group(3)}(),"
            f"{match.group(4)}=await {match.group(2)}.services,"
            f"{match.group(4)}.devboxService}}"
        ),
        source,
        count=1,
    )
    if count:
        path.write_text(source)
        patched = True
        break

if not patched:
    raise SystemExit("Failed to patch app-host services")
PY

python3 - <<'PY'
import re
from pathlib import Path

patched = False
pattern = re.compile(
    r"function ([A-Za-z0-9_$]+)\(e,t\)\{let ([A-Za-z0-9_$]+)=([A-Za-z0-9_$]+)\(e,t\),([A-Za-z0-9_$]+)=new Map\(\2\.map\(\(e,t\)=>\[e,t\]\)\);return\[\.\.\.e\]\.sort\(\(e,t\)=>\(\4\.get\(e\.projectId\)\?\?2\*\*53-1\)-\(\4\.get\(t\.projectId\)\?\?2\*\*53-1\)\)\}"
)
for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    source, count = pattern.subn(
        lambda match: (
            f"function {match.group(1)}(e,t){{"
            f"let {match.group(2)}=window.__ELECTRON_SHIM__?.folderFilterProjectId,"
            f"r={match.group(2)}==null?e:e.filter(e=>e.projectId==={match.group(2)}||e.path==={match.group(2)}),"
            f"i={match.group(3)}(r,t),"
            f"a=new Map(i.map((e,t)=>[e,t]));"
            f"return[...r].sort((e,t)=>(a.get(e.projectId)??2**53-1)-(a.get(t.projectId)??2**53-1))}}"
        ),
        source,
        count=1,
    )
    if count:
        path.write_text(source)
        patched = True
        break

if not patched:
    raise SystemExit("Failed to patch folder-filtered project groups")
PY
while IFS= read -r sentry_bundle; do
  python3 - "$sentry_bundle" <<'PY'
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
source = path.read_text()
source, count = re.subn(
    r"(return GB\(\{)(dsn:)", r"\1enabled:!1,\2", source, count=1
)
if count:
    path.write_text(source)
PY
done < <(grep -rlF "Sentry SDK should be initialized before the Electron app" scratch/asar/.vite/build --include='*.js' || true)

python3 - <<'PY'
import re
from pathlib import Path

for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    if "getSentryInitOptions" not in source:
        continue
    source = source.replace("Vk({beforeSend:", "Vk({enabled:!1,beforeSend:", 1)
    source = source.replace("Ngn({beforeSend:", "Ngn({enabled:!1,beforeSend:", 1)
    source, count = re.subn(
        r"function ([A-Za-z0-9_$]+)\(\)\{if\(([A-Za-z0-9_$]+)\)return;\2=!0;let e=window\.electronBridge\?\.getSentryInitOptions\?\.\(\);if\(!e\)return;.*?Jvt\([A-Za-z0-9_$]+\)\}",
        lambda match: f"function {match.group(1)}(){{}}",
        source,
        count=1,
    )
    path.write_text(source)
