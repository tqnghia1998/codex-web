#!/usr/bin/env bash
set -euxo pipefail

CODEX_APP_DIR="${CODEX_APP_DIR:-/Applications/ChatGPT.app}"
APP_ASAR="$CODEX_APP_DIR/Contents/Resources/app.asar"
if [[ ! -f "$APP_ASAR" ]]; then
  echo "Codex Desktop app.asar not found: $APP_ASAR" >&2
  echo "Set CODEX_APP_DIR to the installed .app path." >&2
  exit 1
fi

rm -rf scratch/asar
if [[ ! -f "node_modules/@electron/asar/bin/asar.mjs" ]]; then
  echo "asar is not installed; run npm install" >&2
  exit 1
fi
node "node_modules/@electron/asar/bin/asar.mjs" extract "$APP_ASAR" "scratch/asar"
cp assets/* scratch/asar/webview/
PWA_SOURCE_ICON="scratch/asar/webview/assets/app-D0g8sCle.png"
PWA_TARGET_ICON="scratch/asar/webview/assets/pwa-icon-512.png"
PWA_ICON_SIZE=512
PWA_TOTAL_PADDING_PERCENT=25
PWA_CONTENT_SIZE=$((PWA_ICON_SIZE * (100 - PWA_TOTAL_PADDING_PERCENT) / 100))
PWA_PADDING_TOTAL=$((PWA_ICON_SIZE - PWA_CONTENT_SIZE))
PWA_PADDING_BEFORE=$((PWA_PADDING_TOTAL / 2))
PWA_PADDING_AFTER=$((PWA_PADDING_TOTAL - PWA_PADDING_BEFORE))
sharp -i "$PWA_SOURCE_ICON" -o "$PWA_TARGET_ICON" -f png resize "$PWA_CONTENT_SIZE" "$PWA_CONTENT_SIZE" --fit inside -- flatten white -- extend "$PWA_PADDING_BEFORE" "$PWA_PADDING_AFTER" "$PWA_PADDING_BEFORE" "$PWA_PADDING_AFTER" --background white -- removeAlpha
if [[ -n "${DEV:-}" ]]; then
  prettier --ignore-path /dev/null --ignore-unknown --write "scratch/asar"
else
  patched_files=()
  missing_patched_files=()
  while IFS= read -r patched_file; do
    if [[ -f "$patched_file" ]]; then
      patched_files+=("$patched_file")
    else
      missing_patched_files+=("$patched_file")
    fi
  done < <(
    awk '/^\+\+\+ b\//{sub(/^\+\+\+ b\//, "scratch/asar/"); print}' patches/*.patch | sort -u
  )

  if (( ${#missing_patched_files[@]} > 0 )); then
    echo "Warning: some patch targets are missing; incompatible patches may fail below:" >&2
    printf '  %s\n' "${missing_patched_files[@]}" >&2
  fi

  prettier --ignore-path /dev/null --ignore-unknown --write "${patched_files[@]}"
fi

PATCH_STRICT="${PATCH_STRICT:-0}"
apply_patch() {
  local patch_file="$1"
  if ! patch --batch --forward --no-backup-if-mismatch --strip 1 --directory scratch/asar < "$patch_file"; then
    if [[ "$PATCH_STRICT" == 1 ]]; then
      return 1
    fi
    echo "Warning: skipped failed patch: $patch_file" >&2
    find scratch/asar -name '*.rej' -delete
  fi
}
apply_patch patches/webview-remove-csp.patch
apply_patch patches/webview-style.patch
apply_patch patches/webview-preload.patch
apply_patch patches/webview-favicon.patch
apply_patch patches/webview-pwa.patch
apply_patch patches/webview-thread-title.patch
apply_patch patches/webview-initial-route.patch
apply_patch patches/webview-electron-shim-close-sidebar.patch
apply_patch patches/webview-prosemirror-inputmode.patch
apply_patch patches/webview-use-atfs-for-local-files.patch
apply_patch patches/webview-prompt-search-param.patch
apply_patch patches/webview-app-host-services.patch
apply_patch patches/sentry-disable-shell.patch
apply_patch patches/sentry-disable-webview.patch

python3 - <<'PY'
import re
from pathlib import Path

index = Path("scratch/asar/webview/index.html")
source = index.read_text()
source, _ = re.subn(
    r"\s*<meta\s+http-equiv=[\"']Content-Security-Policy[\"'][^>]*>",
    "",
    source,
    flags=re.IGNORECASE,
)
if '<base href="/"' not in source:
    source = source.replace(
        "<!-- PROD_BASE_TAG_HERE -->",
        "<!-- PROD_BASE_TAG_HERE -->\n    <base href=\"/\" />",
        1,
    )
if 'src="./assets/preload.js?v=8"' not in source:
    source = source.replace(
        "<!-- PROD_CSP_TAG_HERE -->",
        "<!-- PROD_CSP_TAG_HERE -->\n    <script type=\"module\" src=\"./assets/preload.js?v=8\"></script>",
        1,
    )
index.write_text(source)
PY

python3 - <<'PY'
from pathlib import Path

for path in Path("scratch/asar/webview/assets").glob("index-*.js"):
    source = path.read_text(errors="ignore")
    updated = source.replace(
        "await e((async()=>{t(),i(),await a()}))();",
        'await e((async()=>{window.electronBridge||await import("./preload.js?v=8"),t(),i(),await a()}))();',
        1,
    )
    if updated != source:
        path.write_text(updated)
        print(f"patched bootstrap preload in {path}")
PY

python3 - <<'PY'
import re
from pathlib import Path

for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    source, count = re.subn(
        r"(\.current\?\?=[A-Za-z0-9_$]+\(\{initialEntries:)n(,initialIndex:[A-Za-z0-9_$]+,v5Compat:!0\}\))",
        r"\1n??[window.__ELECTRON_SHIM__?.initialRoute??`/`]\2",
        source,
        count=1,
    )
    if count:
        source, navigation_count = re.subn(
            r"(l=[A-Za-z0-9_$]+\.useCallback\(e=>\{)(i===!1\?c\(e\):[A-Za-z0-9_$]+\.startTransition\(\(\)=>[A-Za-z0-9_$]+\(e\)\))",
            r"\1window.__ELECTRON_SHIM__?.onMemoryNavigationChanged?.(e);\2",
            source,
            count=1,
        )
        path.write_text(source)
        print(f"patched initial route in {path} (navigation: {navigation_count})")

for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    source, count = re.subn(
        r"ge=x\?null:O\?\?Te\(`~`\)",
        "ge=x?null:P?.hostId==null&&P?.projectId!=null?P.projectId:O??Te(`~`)",
        source,
        count=1,
    )
    if count:
        path.write_text(source)
        print(f"patched project root in {path}")

PY

python3 - <<'PY'
import re
from pathlib import Path

for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    original = source
    source = source.replace(
        "function DZe(){dC=EZe(),fC=await dC.services,fC.devboxService}",
        "function DZe(){if(window.__ELECTRON_SHIM__?.services!=null){dC={services:Promise.resolve(window.__ELECTRON_SHIM__.services)},fC=window.__ELECTRON_SHIM__.services,fC.devboxService;return}dC=EZe(),fC=await dC.services,fC.devboxService}",
        1,
    )
    if source != original:
        path.write_text(source)
        print(f"patched app-host services in {path}")

PY
while IFS= read -r sentry_bundle; do
  python3 - "$sentry_bundle" <<'PY'
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
source = path.read_text()
source, count = re.subn(
    r"(return GB\(\{)(dsn:)", r"\1enabled:!1,\2", source, count=1
)
if count:
    path.write_text(source)
else:
    print(f"Warning: could not disable Sentry in {path}", file=sys.stderr)
PY
done < <(grep -rlF "Sentry SDK should be initialized before the Electron app" scratch/asar/.vite/build --include='*.js' || true)

python3 - <<'PY'
import re
from pathlib import Path

for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    if "getSentryInitOptions" not in source:
        continue
    source = source.replace("Vk({beforeSend:", "Vk({enabled:!1,beforeSend:", 1)
    source = source.replace("Ngn({beforeSend:", "Ngn({enabled:!1,beforeSend:", 1)
    source, count = re.subn(
        r"function ([A-Za-z0-9_$]+)\(\)\{if\(([A-Za-z0-9_$]+)\)return;\2=!0;let e=window\.electronBridge\?\.getSentryInitOptions\?\.\(\);if\(!e\)return;.*?Jvt\([A-Za-z0-9_$]+\)\}",
        lambda match: f"function {match.group(1)}(){{}}",
        source,
        count=1,
    )
    path.write_text(source)
PY

python3 - <<'PY'
from pathlib import Path

replacement = "function Fve(){let e=(0,m1.useCallback)(()=>null,[]),t=(0,m1.useCallback)(async()=>{},[]),n=(0,m1.useCallback)(async()=>({status:`dropped`,reason:`Structured analytics disabled`,statsigUser:null}),[]);return(0,m1.useMemo)(()=>({flush:t,getStatsigUserSnapshot:e,trackCounter:t,trackStructuredEvent:n}),[t,e,n])}"
patched = False
for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    if "https://chatgpt.com/ces/v1/rgstr" not in source:
        continue
    start = source.find("function Fve({appVersion:e,client:t,deviceId:n,enabled:r}){")
    end = source.find("function Ive(e){", start)
    if start == -1 or end == -1:
        continue
    path.write_text(source[:start] + replacement + source[end:])
    print(f"disabled structured analytics in {path}")
    patched = True

if not patched:
    print("Warning: could not disable renderer structured analytics", flush=True)
PY

python3 - <<'PY'
from pathlib import Path

path = Path("scratch/asar/.vite/build/src-HagpvBpE.js")
source = path.read_text(errors="ignore")
needle = "AY=`https://chat.openai.com/ces/v1/telemetry/intake`,jY=`dummy-token`,MY=2e3,NY=3e4,PY=5,FY=!1,IY=class{batcher;fetchImpl;queue=[];disabled=!1;"
replacement = "AY=`https://chat.openai.com/ces/v1/telemetry/intake`,jY=`dummy-token`,MY=2e3,NY=3e4,PY=5,FY=!1,IY=class{batcher;fetchImpl;queue=[];disabled=!0;"
if needle in source:
    path.write_text(source.replace(needle, replacement, 1))
else:
    print("Warning: could not disable shell telemetry transport", flush=True)
PY

python3 - <<'PY'
from pathlib import Path

index_html = Path("scratch/asar/webview/index.html").read_text(errors="ignore")
asset_sources = [path.read_text(errors="ignore") for path in Path("scratch/asar/webview/assets").glob("*.js")]
index_sources = [path.read_text(errors="ignore") for path in Path("scratch/asar/webview/assets").glob("index-*.js")]
shell_source = Path("scratch/asar/.vite/build/src-HagpvBpE.js").read_text(errors="ignore")

checks = {
    "base href injection": '<base href="/" />' in index_html,
    "preload script tag": 'src="./assets/preload.js?v=8"' in index_html,
    "bootstrap preload import": any('await import("./preload.js?v=8")' in source for source in index_sources),
    "initial route shim": any('window.__ELECTRON_SHIM__?.initialRoute??`/`' in source for source in asset_sources),
    "app-host shim": any('window.__ELECTRON_SHIM__?.services!=null' in source for source in asset_sources),
    "renderer analytics disabled": any('Structured analytics disabled' in source for source in asset_sources),
    "shell telemetry disabled": 'IY=class{batcher;fetchImpl;queue=[];disabled=!0;' in shell_source,
}

missing = [name for name, ok in checks.items() if not ok]
if missing:
    raise SystemExit(
        "Critical Codex web patches are missing after setup: "
        + ", ".join(missing)
        + ". The installed ChatGPT.app likely changed; update scripts/prepare_asar patch signatures."
    )
PY

rm -rf scratch/asar/node_modules/better-sqlite3
