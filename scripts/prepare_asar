python3 - <<'PY'
import re
from pathlib import Path

initial_route_patched = False
for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    source, count = re.subn(
        r"(\.current\?\?=[A-Za-z0-9_$]+\(\{initialEntries:)n(,initialIndex:[A-Za-z0-9_$]+,v5Compat:!0\}\))",
        r"\1n??[window.__ELECTRON_SHIM__?.initialRoute??`/`]\2",
        source,
        count=1,
    )
    if count:
        source, navigation_count = re.subn(
            r"(l=[A-Za-z0-9_$]+\.useCallback\(e=>\{)(i===!1\?c\(e\):[A-Za-z0-9_$]+\.startTransition\(\(\)=>[A-Za-z0-9_$]+\(e\)\))",
            r"\1window.__ELECTRON_SHIM__?.onMemoryNavigationChanged?.(e);\2",
            source,
            count=1,
        )
        path.write_text(source)
        initial_route_patched = True

if not initial_route_patched:
    raise SystemExit("Failed to patch initial route shim")

sidebar_patched = False
for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    if "sidebar-width" not in source or "data-app-shell-sidebar-trigger" not in source:
        continue

    marker = source.index("sidebar-width")
    prefix, tail = source[:marker], source[marker:]
    tail, open_count = re.subn(
        r"(?P<store>R)=d\(f,!0\)",
        r"\g<store>=d(f,window.__ELECTRON_SHIM__?.initialSidebarState??!0)",
        tail,
        count=1,
    )
    tail, spring_count = re.subn(
        r"(?P<store>H)=d\(f,\(\)=>new (?P<spring>h)\(1\)\)",
        r"\g<store>=d(f,()=>new \g<spring>(window.__ELECTRON_SHIM__?.initialSidebarState?1:0))",
        tail,
        count=1,
    )
    if not (open_count and spring_count):
        continue

    path.write_text(prefix + tail)
    sidebar_patched = True
    break

if not sidebar_patched:
    raise SystemExit("Failed to patch sidebar initial state")

for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    source, count = re.subn(
        r"ge=x\?null:O\?\?Te\(`~`\)",
        "ge=x?null:P?.hostId==null&&P?.projectId!=null?P.projectId:O??Te(`~`)",
        source,
        count=1,
    )
    if count:
        path.write_text(source)

