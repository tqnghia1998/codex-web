python3 - <<'PY'
import re
from pathlib import Path

# `reviewSnapshot` for untracked files used to drop any untracked path that
# wasn't already in `metadata.files`. The upstream function only relabels
# existing entries as `untracked`; it never injects untracked paths that are
# absent from the review metadata. We extend the file list with the missing
# untracked paths so the summary actually reflects them. Match only the
# function head + the first `let <o>=<dedup>(<m>.files.map(...))` expression
# (stable anchors, drift-tolerant captures) and leave the rest of the body
# untouched.
path = Path("scratch/asar/.vite/build/worker.js")
source = path.read_text(errors="ignore")

sig = re.compile(
    r"async function (?P<fn>[A-Za-z0-9_$]+)\(\{host:(?P<h>[A-Za-z0-9_$]+),gitRoot:(?P<g>[A-Za-z0-9_$]+),metadata:(?P<m>[A-Za-z0-9_$]+),reviewSnapshot:(?P<r>[A-Za-z0-9_$]+),source:(?P<s>[A-Za-z0-9_$]+),untrackedPathSet:(?P<u>[A-Za-z0-9_$]+)\}\)\{"
    r"let (?P<o>[A-Za-z0-9_$]+)=(?P<dedup>[A-Za-z0-9_$]+)\((?P=m)\.files\.map\((?P<farg>[A-Za-z0-9_$]+)=>(?P=farg)\.previousPath==null&&(?P=u)\.has\((?P=farg)\.path\)\?\{\.\.\.(?P=farg),changeKind:`untracked`\}:(?P=farg)\)\),"
)
m = sig.search(source)
if not m:
    raise SystemExit("Failed to patch worker review summary untracked files")

g = m.groupdict()
# ponytail: reuse a guaranteed-fresh identifier for the missing-untracked list
# so we don't redeclare the `untrackedPathSet` param (a SyntaxError).
# The original `let o=DEDUP(...)` becomes: build a Set of known paths,
# compute missing untracked entries, then reassign o = DEDUP(extended list).
extra = "__cw_untracked"
new = (
    f"async function {g['fn']}({{host:{g['h']},gitRoot:{g['g']},metadata:{g['m']},reviewSnapshot:{g['r']},source:{g['s']},untrackedPathSet:{g['u']}}}){{"
    f"let {g['o']}=new Set({g['m']}.files.map({g['farg']}=>{g['farg']}.path));"
    f"let {extra}=[...{g['u']}].filter({g['farg']}=>!{g['o']}.has({g['farg']})).map({g['farg']}=>({{additions:null,changeKind:`untracked`,deletions:null,path:{g['farg']},previousPath:null}}));"
    f"{g['o']}={g['dedup']}([...{g['m']}.files.map({g['farg']}=>{g['farg']}.previousPath==null&&{g['u']}.has({g['farg']}.path)?{{...{g['farg']},changeKind:`untracked`}}:{g['farg']}),...{extra}]);"
)
path.write_text(source[:m.start()] + new + source[m.end():])
PY
