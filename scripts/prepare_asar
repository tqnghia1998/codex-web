python3 - <<'PY'
import re
from pathlib import Path

pattern = re.compile(
    r"function ([A-Za-z0-9_$]+)\(e\)\{return`\$\{([A-Za-z0-9_$]+)\}\$\{([A-Za-z0-9_$]+)\(e\)\}`\}function ([A-Za-z0-9_$]+)\(e\)\{return \3\(e\)\}"
)
candidates = []

for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    if "`app://fs`" not in source or "`/@fs`" not in source:
        continue

    for match in pattern.finditer(source):
        if f"{match.group(2)}=`app://fs`" in source:
            candidates.append((path, source, match))

if len(candidates) != 1:
    raise SystemExit(
        f"Failed to patch local file URL helper: expected 1 candidate, found {len(candidates)}"
    )

path, source, match = candidates[0]
updated = (
    source[: match.start()]
    + (
        f"function {match.group(1)}(e){{return {match.group(3)}(e)}}"
        f"function {match.group(4)}(e){{return {match.group(3)}(e)}}"
    )
    + source[match.end() :]
)

if updated == source:
    raise SystemExit("Failed to patch local file URL helper")

path.write_text(updated)
PY

python3 - <<'PY'
from pathlib import Path

needle = "canCopyBrowserFileAttachments:!1"
replacement = "canCopyBrowserFileAttachments:!0"
matches = []

for path in Path("scratch/asar/webview/assets").glob("*.js"):
    source = path.read_text(errors="ignore")
    count = source.count(needle)
    if count:
        matches.append((path, source, count))

match_count = sum(count for _, _, count in matches)
if match_count != 1:
    raise SystemExit(
        f"Failed to enable browser file attachment copying: expected 1 match, found {match_count}"
    )

path, source, _ = matches[0]
path.write_text(source.replace(needle, replacement, 1))
PY

