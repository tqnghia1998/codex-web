{
  "name": "codex-web",
  "version": "0.0.1",
  "files": [
    "README.md",
    "scratch/asar/**/*",
    "src/server/**/*.js",
    "src/server/electron/index.js",
    "!**/*.ts"
  ],
  "bin": "src/server/main.js",
  "scripts": {
    "setup": "./scripts/prepare_asar && vite build --config vite.browser.config.ts && cd src/server && tsc",
    "build": "npm run setup && node scripts/build.mjs",
    "run": "CODEX_CLI_PATH=${CODEX_CLI_PATH:-$(command -v codex)} node src/server/main.js"
  },
  "repository": "git@github.com:0xcaff/codex-web.git",
  "author": "martin <martincharles07@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.1",
    "better-sqlite3": "^12.9.0",
    "fastify": "^5.8.5",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "prettier": "^3.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp-cli": "^5.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  }
}
